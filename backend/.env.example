# Backend environment variables — copy to .env and fill in real values
# Never commit .env to Git

# PostgreSQL async connection URL
DATABASE_URL=postgresql+asyncpg://personalweb_app:CHANGE_ME@127.0.0.1:5432/personalweb

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_PAGES_PROJECT.pages.dev
